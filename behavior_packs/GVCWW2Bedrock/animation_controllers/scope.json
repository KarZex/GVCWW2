{
    "format_version": "1.10.0",
    "animation_controllers": {
      "controller.animation.ads": {
        "states": {
          "default": {
            "transitions": [
              { "x6": "query.property('zex:scope') == 1 && query.is_sneaking" },
				      { "scopeing": "query.is_sneaking" }
            ]
          },
          "x6": {
            "transitions": [
                {"default":"!query.is_sneaking"}
            ],
            "on_entry": [
              "/effect @s slowness 1000 6 true",
              "/event entity @s gvcv5:start_scope",
              "/tag @s add scope"
            ],
            "on_exit": [
              "/effect @s slowness 0 0 true",
              "/event entity @s gvcv5:stop_scope",
              "/tag @s remove scope"
            ]
          },
          "x3": {
            "transitions": [
                {"default":"!query.is_sneaking"}
            ],
            "on_entry": [
              "/effect @s slowness 1000 6 true",
              "/tag @s add scope"
            ],
            "on_exit": [
              "/effect @s slowness 0 0 true",
              "/tag @s remove scope"
            ]
          },
          "x1": {
            "transitions": [
                {"default":" !query.is_sneaking"}
            ],
            "on_entry": [
              "/tag @s add scope"
            ],
            "on_exit": [
              "/tag @s remove scope"
            ]
          },
          "scopeing": {
            "transitions": [
                {"default":"!query.is_sneaking"}
            ],
            "on_entry": [
              "/tag @s add scope"
            ],
            "on_exit": [
              "/tag @s remove scope"
            ]
          }
        }
      }
   }
}